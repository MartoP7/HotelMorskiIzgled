@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Забравена парола";
}

<div class="auth-page">
    <div class="auth-overlay"></div>

    <div class="auth-container auth-small-container">
        <div class="auth-card">

            <div class="auth-header">
                <h1>Забравена парола</h1>
                <p>Въведете имейла си и ще получите инструкции за смяна на паролата.</p>
            </div>

            <div class="auth-single-layout">
                <section class="auth-form-card">
                    <div class="auth-section-label">
                        <i class="bi bi-key"></i>
                        Възстановяване
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="auth-form-group">
                            <label asp-for="Input.Email" class="auth-label">Имейл</label>
                            <div class="auth-input-wrapper">
                                <i class="bi bi-envelope"></i>
                                <input asp-for="Input.Email"
                                       class="form-control auth-input"
                                       autocomplete="username"
                                       aria-required="true"
                                       placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary auth-submit-btn">
                            <i class="bi bi-arrow-clockwise"></i>
                            Възстанови парола
                        </button>

                        <div class="auth-links">
                            <a asp-page="./Login">Назад към вход</a>
                        </div>
                    </form>
                </section>

                <section class="auth-info-card">
                    <span class="auth-section-label">
                        <i class="bi bi-shield-lock"></i>
                        Сигурност
                    </span>

                    <h2>Смяна на парола</h2>

                    <div class="auth-benefits">
                        <div>
                            <i class="bi bi-envelope-check"></i>
                            <span>Ще получите линк за смяна на паролата.</span>
                        </div>

                        <div>
                            <i class="bi bi-lock"></i>
                            <span>Изберете нова сигурна парола.</span>
                        </div>

                        <div>
                            <i class="bi bi-person-check"></i>
                            <span>След това ще можете да влезете отново.</span>
                        </div>
                    </div>
                </section>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}