@model ASPMorskiIzgled.Models.ViewModels.ReservationReportView

@{
    ViewData["Title"] = "Отчет";
}

<div class="admin-page">
    <div class="admin-overlay"></div>

    <div class="admin-container">
        <div class="admin-card">

            <div class="admin-header">
                <div>
                    <h1>Отчет за резервации</h1>
                    <p>Изберете период, за да видите приходите и статистиката за резервациите.</p>
                </div>

                <a asp-action="Index" class="btn btn-outline-secondary admin-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Назад
                </a>
            </div>

            <form asp-action="Report" method="get" class="report-filter-form">
                <div class="report-filter-grid">

                    <div class="admin-form-group">
                        <label class="admin-label">От дата</label>
                        <div class="admin-input-wrapper">
                            <i class="bi bi-calendar-event"></i>
                            <input type="date"
                                   name="dateFrom"
                                   value="@Model.DateFrom.ToString("yyyy-MM-dd")"
                                   class="form-control admin-input" />
                        </div>
                    </div>

                    <div class="admin-form-group">
                        <label class="admin-label">До дата</label>
                        <div class="admin-input-wrapper">
                            <i class="bi bi-calendar-check"></i>
                            <input type="date"
                                   name="dateTo"
                                   value="@Model.DateTo.ToString("yyyy-MM-dd")"
                                   class="form-control admin-input" />
                        </div>
                    </div>

                    <div class="report-filter-actions">
                        <button type="submit" class="btn btn-primary admin-submit-btn">
                            <i class="bi bi-search"></i>
                            Покажи отчет
                        </button>
                    </div>

                </div>
            </form>

            <div class="report-summary-grid">

                <div class="report-summary-card">
                    <div class="report-summary-icon blue">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div>
                        <span>Общо резервации</span>
                        <strong>@Model.TotalReservations</strong>
                    </div>
                </div>

                <div class="report-summary-card">
                    <div class="report-summary-icon purple">
                        <i class="bi bi-moon-stars"></i>
                    </div>
                    <div>
                        <span>Общо нощувки</span>
                        <strong>@Model.TotalNights</strong>
                    </div>
                </div>

                <div class="report-summary-card">
                    <div class="report-summary-icon green">
                        <i class="bi bi-currency-euro"></i>
                    </div>
                    <div>
                        <span>Общ доход</span>
                        <strong>@Model.TotalIncome€</strong>
                    </div>
                </div>

                <div class="report-summary-card">
                    <div class="report-summary-icon orange">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div>
                        <span>Средно на резервация</span>
                        <strong>@Model.AverageReservationIncome€</strong>
                    </div>
                </div>

            </div>

            <div class="report-period-box">
                <i class="bi bi-info-circle"></i>
                <span>
                    Показани са резервации за периода
                    <strong>@Model.DateFrom.ToString("dd.MM.yyyy")</strong>
                    -
                    <strong>@Model.DateTo.ToString("dd.MM.yyyy")</strong>
                </span>
            </div>

            <div class="admin-table-wrapper">
                <table class="table admin-table report-table">
                    <thead>
                        <tr>
                            <th>Стая</th>
                            <th>Клиент</th>
                            <th>Настаняване</th>
                            <th>Напускане</th>
                            <th>Нощувки</th>
                            <th>Цена / нощувка</th>
                            <th>Общо</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Reservations != null && Model.Reservations.Any())
                        {
                            @foreach (var item in Model.Reservations)
                            {
                                <tr>
                                    <td>
                                        <div class="admin-reservation-room">
                                            <i class="bi bi-door-open"></i>
                                            <span>@item.RoomName</span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="admin-reservation-client">
                                            <i class="bi bi-person-circle"></i>
                                            <span>@item.ClientName</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="admin-date-pill">
                                            <i class="bi bi-calendar-check"></i>
                                            @item.DateIn.ToString("dd.MM.yyyy")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="admin-date-pill">
                                            <i class="bi bi-calendar-x"></i>
                                            @item.DateOut.ToString("dd.MM.yyyy")
                                        </span>
                                    </td>

                                    <td>
                                        <strong>@item.Nights</strong>
                                    </td>

                                    <td>
                                        @item.PricePerNight€
                                    </td>

                                    <td>
                                        <strong class="report-income-text">@item.TotalPrice€</strong>
                                    </td>

                                    <td>
                                        <div class="admin-actions">
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i>
                                                Детайли
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="admin-empty-box">
                                        <i class="bi bi-info-circle"></i>
                                        Няма резервации за избрания период.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>