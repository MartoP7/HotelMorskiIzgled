@model IEnumerable<ASPMorskiIzgled.Models.Reservation>

@{
    ViewData["Title"] = "Резервации";
}

<div class="admin-page">
    <div class="admin-overlay"></div>

    <div class="admin-container">
        <div class="admin-card">

            <div class="admin-header">
                <div>
                    <h1>Резервации</h1>
                    <p>Преглед и управление на всички направени резервации от потребителите.</p>
                </div>

                <a asp-controller="Rooms"
                   asp-action="IndexReservation"
                   class="btn btn-primary admin-create-btn">
                    <i class="bi bi-search"></i>
                    Нова резервация
                </a>
            </div>

            <div class="admin-table-wrapper">
                <table class="table admin-table reservations-admin-table">
                    <thead>
                        <tr>
                            <th>Стая</th>
                            <th>Клиент</th>
                            <th>Настаняване</th>
                            <th>Напускане</th>
                            <th>Дата на резервация</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="admin-reservation-room">
                                            <i class="bi bi-door-open"></i>
                                            <span>@item.Rooms.Name</span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="admin-reservation-client">
                                            <i class="bi bi-person-circle"></i>
                                            <span>@item.Clients.FirstName @item.Clients.LastName</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="admin-date-pill">
                                            <i class="bi bi-calendar-check"></i>
                                            @item.DateIn.ToString("dd.MM.yyyy")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="admin-date-pill">
                                            <i class="bi bi-calendar-x"></i>
                                            @item.DateOut.ToString("dd.MM.yyyy")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="admin-reservation-created">
                                            @item.ReservationDate.ToString("dd.MM.yyyy")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="admin-actions">
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i>
                                                Детайли
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil-square"></i>
                                                Редактирай
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                                Изтрий
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="admin-empty-box">
                                        <i class="bi bi-info-circle"></i>
                                        Все още няма направени резервации.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>