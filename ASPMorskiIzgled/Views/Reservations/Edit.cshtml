@model ASPMorskiIzgled.Models.Reservation

@{
    ViewData["Title"] = "Редакция на резервация";
}

<div class="admin-page">
    <div class="admin-overlay"></div>

    <div class="admin-container">
        <div class="admin-card admin-form-card">

            <div class="admin-header">
                <div>
                    <h1>Редактирай резервация</h1>
                    <p>Промени стаята или датите на резервацията.</p>
                </div>

                <a asp-action="Index" class="btn btn-outline-secondary admin-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Назад
                </a>
            </div>

            <form asp-action="Edit" class="admin-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ClientId" />

                <div class="admin-form-grid">

                    <div class="admin-form-group">
                        <label class="admin-label">Клиент</label>
                        <div class="admin-input-wrapper">
                            <i class="bi bi-person-circle"></i>
                            <input class="form-control admin-input"
                                   value="@Model.Clients?.FirstName @Model.Clients?.LastName"
                                   readonly />
                        </div>
                    </div>

                    <div class="admin-form-group">
                        <label asp-for="RoomId" class="admin-label">Стая</label>
                        <div class="admin-input-wrapper">
                            <i class="bi bi-door-open"></i>
                            <select asp-for="RoomId"
                                    class="form-select admin-input"
                                    asp-items="ViewBag.RoomId"></select>
                        </div>
                        <span asp-validation-for="RoomId" class="text-danger"></span>
                    </div>

                    <div class="admin-form-group">
                        <label asp-for="DateIn" class="admin-label">Дата на настаняване</label>
                        <div class="admin-input-wrapper">
                            <i class="bi bi-calendar-check"></i>
                            <input asp-for="DateIn"
                                   class="form-control admin-input"
                                   type="date" />
                        </div>
                        <span asp-validation-for="DateIn" class="text-danger"></span>
                    </div>

                    <div class="admin-form-group">
                        <label asp-for="DateOut" class="admin-label">Дата на напускане</label>
                        <div class="admin-input-wrapper">
                            <i class="bi bi-calendar-x"></i>
                            <input asp-for="DateOut"
                                   class="form-control admin-input"
                                   type="date" />
                        </div>
                        <span asp-validation-for="DateOut" class="text-danger"></span>
                    </div>

                </div>

                <div class="admin-form-actions">
                    <button type="submit" class="btn btn-primary admin-submit-btn">
                        <i class="bi bi-pencil-square"></i>
                        Запази промените
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary admin-cancel-btn">
                        Отказ
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}