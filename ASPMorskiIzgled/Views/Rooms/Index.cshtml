@model IEnumerable<ASPMorskiIzgled.Models.Room>

@{
    ViewData["Title"] = "Стаи";
}

<div class="admin-page">
    <div class="admin-overlay"></div>

    <div class="admin-container">
        <div class="admin-card">

            <div class="admin-header">
                <div>
                    <h1>Стаи</h1>
                    <p>Управление на всички стаи в хотел Морски Изглед.</p>
                </div>

                <a asp-action="Create" class="btn btn-primary admin-create-btn">
                    <i class="bi bi-plus-circle"></i>
                    Добави стая
                </a>
            </div>

            <div class="admin-table-wrapper">
                <table class="table admin-table rooms-admin-table">
                    <thead>
                        <tr>
                            <th>Снимка</th>
                            <th>Име</th>
                            <th>Тип</th>
                            <th>Описание</th>
                            <th>Кошара</th>
                            <th>Диван</th>
                            <th>Цена</th>
                            <th>Дата</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                var photos = item.Photo?
                                .Split(';', StringSplitOptions.RemoveEmptyEntries)
                                .Select(p => p.Trim())
                                .ToList() ?? new List<string>();

                                var mainPhoto = photos.FirstOrDefault() ?? "/images/no-image.jpg";

                                <tr>
                                    <td>
                                        <img src="@mainPhoto" alt="@item.Name" class="admin-room-img" />
                                    </td>

                                    <td>
                                        <div class="admin-room-name">
                                            <i class="bi bi-door-open"></i>
                                            <span>@item.Name</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="admin-badge">
                                            @item.RoomTypes?.Name
                                        </span>
                                    </td>

                                    <td>
                                        <span class="admin-description admin-room-description">
                                            @item.Description
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.SleepingCot)
                                        {
                                            <span class="admin-status yes">
                                                <i class="bi bi-check-circle"></i>
                                                Да
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-status no">
                                                <i class="bi bi-x-circle"></i>
                                                Не
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.SofaBed)
                                        {
                                            <span class="admin-status yes">
                                                <i class="bi bi-check-circle"></i>
                                                Да
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-status no">
                                                <i class="bi bi-x-circle"></i>
                                                Не
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <strong>@item.Price€</strong>
                                    </td>

                                    <td>
                                        @item.DateReg.ToString("dd.MM.yyyy")
                                    </td>

                                    <td>
                                        <div class="admin-actions">
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i>
                                                Детайли
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil-square"></i>
                                                Редактирай
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                                Изтрий
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9">
                                    <div class="admin-empty-box">
                                        <i class="bi bi-info-circle"></i>
                                        Все още няма добавени стаи.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>