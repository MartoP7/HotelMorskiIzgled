@model ASPMorskiIzgled.Models.Room

@{
    ViewData["Title"] = "Редакция на стая";
}

<div class="admin-page">
    <div class="admin-overlay"></div>

    <div class="admin-container">
        <div class="admin-card admin-form-card">

            <div class="admin-header">
                <div>
                    <h1>Редактирай стая</h1>
                    <p>Промени информацията за избраната стая.</p>
                </div>

                <a asp-action="Index" class="btn btn-outline-secondary admin-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Назад
                </a>
            </div>

            <form asp-action="Edit" class="admin-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />

                <div class="admin-form-grid">

                    <div class="admin-form-group">
                        <label asp-for="Name" class="admin-label">Име на стаята</label>
                        <div class="admin-input-wrapper">
                            <i class="bi bi-door-open"></i>
                            <input asp-for="Name" class="form-control admin-input" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="admin-form-group">
                        <label asp-for="RoomTypeId" class="admin-label">Вид стая</label>
                        <div class="admin-input-wrapper">
                            <i class="bi bi-building"></i>
                            <select asp-for="RoomTypeId" class="form-select admin-input" asp-items="ViewBag.RoomTypeId"></select>
                        </div>
                        <span asp-validation-for="RoomTypeId" class="text-danger"></span>
                    </div>

                    <div class="admin-form-group">
                        <label asp-for="Price" class="admin-label">Цена</label>
                        <div class="admin-input-wrapper">
                            <i class="bi bi-currency-euro"></i>
                            <input asp-for="Price" class="form-control admin-input" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                </div>

                <div class="admin-form-group">
                    <label asp-for="Photo" class="admin-label">Снимки</label>
                    <div class="admin-input-wrapper admin-textarea-wrapper">
                        <i class="bi bi-images"></i>
                        <textarea asp-for="Photo"
                                  class="form-control admin-input admin-textarea"
                                  rows="4"
                                  placeholder="/images/room1.jpg;/images/room1-2.jpg;/images/room1-3.jpg"></textarea>
                    </div>
                    <small class="admin-help-text">
                        Въведи няколко снимки, разделени със символ <strong>;</strong>. Първата снимка ще бъде главна.
                    </small>
                    <span asp-validation-for="Photo" class="text-danger"></span>
                </div>

                <div class="admin-form-group">
                    <label asp-for="Description" class="admin-label">Описание</label>
                    <div class="admin-input-wrapper admin-textarea-wrapper">
                        <i class="bi bi-card-text"></i>
                        <textarea asp-for="Description"
                                  class="form-control admin-input admin-textarea"
                                  rows="5"></textarea>
                    </div>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="admin-checkbox-grid">
                    <label class="admin-checkbox-card">
                        <input asp-for="SleepingCot" class="form-check-input" />
                        <span>
                            <i class="fa-solid fa-baby"></i>
                            Детска кошара
                        </span>
                    </label>

                    <label class="admin-checkbox-card">
                        <input asp-for="SofaBed" class="form-check-input" />
                        <span>
                            <i class="fa-solid fa-couch"></i>
                            Разтегателен диван
                        </span>
                    </label>
                </div>

                <div class="admin-form-actions">
                    <button type="submit" class="btn btn-primary admin-submit-btn">
                        <i class="bi bi-pencil-square"></i>
                        Запази промените
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary admin-cancel-btn">
                        Отказ
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}