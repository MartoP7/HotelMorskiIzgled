@model ASPMorskiIzgled.Models.RoomType

@{
    ViewData["Title"] = "Детайли за тип стая";
}

<div class="admin-page">
    <div class="admin-overlay"></div>

    <div class="admin-container">
        <div class="admin-card admin-details-card">

            <div class="admin-header">
                <div>
                    <h1>Детайли за тип стая</h1>
                    <p>Преглед на информацията за избрания тип стая.</p>
                </div>

                <a asp-action="Index" class="btn btn-outline-secondary admin-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Назад
                </a>
            </div>

            <div class="admin-details-content">

                <div class="admin-detail-box">
                    <div class="admin-detail-icon">
                        <i class="bi bi-door-open"></i>
                    </div>

                    <div class="admin-detail-info">
                        <span class="admin-detail-label">Име на тип стая</span>
                        <h2>@Model.Name</h2>
                    </div>
                </div>

                <div class="admin-detail-box">
                    <div class="admin-detail-icon">
                        <i class="bi bi-card-text"></i>
                    </div>

                    <div class="admin-detail-info">
                        <span class="admin-detail-label">Описание</span>
                        <p>@Model.Description</p>
                    </div>
                </div>

            </div>

            <div class="admin-form-actions">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary admin-submit-btn">
                    <i class="bi bi-pencil-square"></i>
                    Редактирай
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger admin-cancel-btn">
                    <i class="bi bi-trash"></i>
                    Изтрий
                </a>
            </div>

        </div>
    </div>
</div>