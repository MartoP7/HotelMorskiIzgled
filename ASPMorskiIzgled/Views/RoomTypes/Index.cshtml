@model IEnumerable<ASPMorskiIzgled.Models.RoomType>

@{
    ViewData["Title"] = "Видове стаи";
}

<div class="admin-page">
    <div class="admin-overlay"></div>

    <div class="admin-container">
        <div class="admin-card">

            <div class="admin-header">
                <div>
                    <h1>Видове стаи</h1>
                    <p>Управление на всички типове стаи в хотел Морски Изглед.</p>
                </div>

                <a asp-action="Create" class="btn btn-primary admin-create-btn">
                    <i class="bi bi-plus-circle"></i>
                    Добави тип стая
                </a>
            </div>

            <div class="admin-table-wrapper">
                <table class="table admin-table">
                    <thead>
                        <tr>
                            <th>Име</th>
                            <th>Описание</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="admin-room-type-name">
                                            <i class="bi bi-door-open"></i>
                                            <span>@item.Name</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="admin-description">
                                            @item.Description
                                        </span>
                                    </td>

                                    <td>
                                        <div class="admin-actions">
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i>
                                                Детайли
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil-square"></i>
                                                Редактирай
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                                Изтрий
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3">
                                    <div class="admin-empty-box">
                                        <i class="bi bi-info-circle"></i>
                                        Все още няма добавени типове стаи.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>